# ==============================================================================
#                 WHATSAPP AI CALL ASSISTANT BOT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Free)
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API=your_gemini_api_key_here

# Gemini conversational AI model
# Options: gemini-3.1-flash-lite (default ~0.3s, generous quota), gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 2. GROQ SPEECH-TO-TEXT (STT) CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Groq API Key (Free) used for Whisper Large v3 speech transcription
# Get it at: https://console.groq.com/keys
GROQ_API=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. TEXT-TO-SPEECH (TTS) ENGINE SELECTION
# ------------------------------------------------------------------------------
# TTS engine options: edgetts / geminitts / elevenlabs / openai / animetts / google
# - edgetts    : 100% FREE FOREVER, Microsoft Azure Neural human-like voices
# - geminitts  : 100% FREE, native Google Gemini Audio voices (Puck, Kore, Aoede)
# - elevenlabs : Most realistic and emotional human voices (free 10k characters/month)
# - openai     : OpenAI Audio voices (paid / credit balance)
# - animetts   : Anime character voices (140+ characters: Umamusume, Genshin, etc.)
# - google     : Google Translate TTS fallback
TTS_ENGINE=edgetts

# ------------------------------------------------------------------------------
# 4. TTS VOICE & PITCH CONFIGURATION
# ------------------------------------------------------------------------------
# Voice options (must match the selected TTS_ENGINE):
# - If TTS_ENGINE=edgetts   : en-US-AvaMultilingualNeural (female), en-US-AndrewMultilingualNeural (male), en-GB-SoniaNeural
# - If TTS_ENGINE=geminitts : Puck (warm neutral/male), Kore (soft female), Aoede (expressive female)
# - If TTS_ENGINE=openai    : nova, shimmer, alloy, echo, onyx, fable, ash, coral, sage
TTS_VOICE=en-US-AvaMultilingualNeural

# Voice pitch adjustment (edgetts only)
# Lowering the pitch (e.g. -2Hz or -1Hz) makes the voice sound more relaxed, warm and natural
TTS_PITCH=-1Hz

# TTS speaking speed (default: 1.0, e.g. 1.2 is faster, 0.8 is slower)
TTS_SPEED=1.0

# ------------------------------------------------------------------------------
# 5. ELEVENLABS & OPENAI API KEYS (Optional)
# ------------------------------------------------------------------------------
# ElevenLabs API Key & Voice ID (if TTS_ENGINE=elevenlabs)
# Get it at: https://elevenlabs.io
ELEVENLABS_API=your_elevenlabs_api_key_here
ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI API Key (if TTS_ENGINE=openai)
# Get it at: https://platform.openai.com/api-keys
OPENAI_API=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. ANIME TTS CONFIGURATION (Optional - only if TTS_ENGINE=animetts)
# ------------------------------------------------------------------------------
# Full character name (see the catalog in VOICE_MODELS.md).
# NOTE: this value is an exact identifier expected by the HuggingFace VITS API,
# so it must be copied verbatim, including the original Chinese/Japanese name.
TTS_CHARACTER=特别周 Special Week (Umamusume Pretty Derby)

# Anime TTS language options: Mix / English / 日本語 / 简体中文
TTS_LANG=Mix

# Language used for the AI conversation prompt
PROMPT_LANG=en

# ------------------------------------------------------------------------------
# 7. OWNER / BOT SECURITY FEATURE
# ------------------------------------------------------------------------------
# Owner phone numbers allowed to use the bot / place calls (comma-separated for multiple)
# Leave empty if you want the bot to be publicly usable by anyone.
# Example: OWNER=628123456789,628987654321
OWNER=628123456789

# ------------------------------------------------------------------------------
# 8. CUSTOM AI CONVERSATION SYSTEM PROMPT
# ------------------------------------------------------------------------------
# The AI's speaking style and instructions during a phone call
SYSTEM_PROMPT="You are a smart AI voice assistant speaking over a WhatsApp phone call. Answer shortly, in a friendly and natural way (maximum 2-3 sentences). DO NOT use markdown formatting (*, #, -, tables)."
